        <item name="android:height">36dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Donapp.BottomNav</item>

    </style>

    <style name="ShapeAppearance.Donapp.BottomNav" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
