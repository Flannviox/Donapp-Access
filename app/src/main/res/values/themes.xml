<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.DonappAccess" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="colorPrimary">@color/donapp_primary</item>
        <item name="colorPrimaryDark">@color/donapp_primary_dark</item>
        <item name="colorAccent">@color/donapp_secondary</item>

        <item name="android:windowBackground">@color/donapp_bg</item>
        <item name="android:colorBackground">@color/donapp_bg</item>
        <item name="colorSurface">@color/donapp_surface</item>

        <item name="android:textColorPrimary">@color/donapp_text_primary</item>
        <item name="android:textColorSecondary">@color/donapp_text_secondary</item>
        <item name="android:textColorHint">@color/donapp_text_hint</item>

        <item name="android:statusBarColor">@color/donapp_bg</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:navigationBarColor">@color/donapp_bg</item>

        <item name="colorControlActivated">@color/donapp_primary</item>
        <item name="colorControlNormal">@color/donapp_text_secondary</item>

        <item name="textInputStyle">@style/Widget.DonappAccess.TextInputLayout</item>
        <item name="materialButtonStyle">@style/Widget.DonappAccess.Button</item>

    </style>

    <style name="Theme.DonappAccess.HighContrast" parent="Theme.DonappAccess">
        <item name="android:windowBackground">@color/contrast_bg</item>
        <item name="android:colorBackground">@color/contrast_bg</item>
        <item name="colorSurface">@color/contrast_surface</item>

        <item name="android:textColorPrimary">@color/contrast_primary</item>
        <item name="android:textColorSecondary">@color/contrast_secondary</item>
        <item name="android:textColorHint">@color/contrast_primary</item>

        <item name="colorControlActivated">@color/contrast_secondary</item> <item name="colorControlNormal">@color/contrast_primary</item> <item name="textInputStyle">@style/Widget.DonappAccess.TextInputLayout.HighContrast</item>
    </style>

    <style name="Widget.DonappAccess.TextInputLayout.HighContrast"
        parent="Widget.DonappAccess.TextInputLayout">
        <item name="boxBackgroundColor">@color/contrast_bg</item>
        <item name="boxStrokeColor">@color/contrast_secondary</item>
        <item name="hintTextColor">@color/contrast_secondary</item>
        <item name="android:textColorHint">@color/contrast_primary</item>
    </style>

    <style name="Widget.DonappAccess.TextInputLayout"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/donapp_input_bg</item>
        <item name="boxStrokeColor">@color/donapp_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/donapp_text_hint</item>
        <item name="android:textColorHint">@color/donapp_text_hint</item>
    </style>

    <style name="Widget.DonappAccess.Button"
        parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/donapp_primary</item>
        <item name="android:textColor">@color/donapp_bg</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Widget.DonappAccess.Button.Outline"
        parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/donapp_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/donapp_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <style name="TextAppearance.DonappAccess" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="TextAppearance.DonappAccess.Title">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="TextAppearance.DonappAccess.Subtitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="Widget.DonappAccess.Card"
        parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/donapp_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>