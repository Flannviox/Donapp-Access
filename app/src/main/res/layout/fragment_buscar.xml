<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="36dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bienvenido!!"
                    android:textColor="@color/donapp_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvNombreUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Cargando..."
                    android:textColor="@color/donapp_text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Que haremos hoy?"
                    android:textColor="@color/donapp_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAvatarInicial"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/bg_circle_yellow"
                android:gravity="center"
                tools:text="?"
                android:textColor="@color/black"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/inputBuscar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:drawableTint="@color/donapp_text_muted"
            android:hint="Busca productos u ofertas"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="28dp"
            android:paddingEnd="16dp"
            android:textColor="@color/donapp_text_primary"
            android:textColorHint="@color/donapp_text_muted"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/progressCategorias"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:indeterminateTint="@color/donapp_yellow"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textEstadoCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textColor="@color/donapp_text_secondary"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Sin categorias" />

        <TextView
            android:id="@+id/buttonRecargarCategorias"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_yellow"
            android:gravity="center"
            android:minWidth="120dp"
            android:text="Reintentar"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            tools:itemCount="6"
            tools:listitem="@layout/item_categoria" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerOfertas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:visibility="gone"
            tools:itemCount="3"
            tools:listitem="@layout/item_oferta" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
