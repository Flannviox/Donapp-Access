<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#2A2A2A"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivProductoImagen"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:cornerRadius="12dp"
            tools:src="@tools:sample/backgrounds/scenic" />

        <TextView
            android:id="@+id/tvDescuento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded" android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textColor="#1A1A1A"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@+id/ivProductoImagen"
            app:layout_constraintTop_toTopOf="@+id/ivProductoImagen"
            tools:backgroundTint="#F5C518"
            tools:text="-50%" />

        <ImageView
            android:id="@+id/ivConfiguracion"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_edit" app:tint="#9E9E9E"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvNombreProducto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintEnd_toStartOf="@+id/ivConfiguracion"
            app:layout_constraintStart_toEndOf="@+id/ivProductoImagen"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Pan Integral San Jorge" />

        <TextView
            android:id="@+id/tvStockCantidad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#9E9E9E"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@+id/tvNombreProducto"
            app:layout_constraintTop_toBottomOf="@+id/tvNombreProducto"
            tools:text="Stock: 15 uds." />

        <TextView
            android:id="@+id/tvExpiracion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#F44336"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@+id/tvStockCantidad"
            app:layout_constraintTop_toBottomOf="@+id/tvStockCantidad"
            tools:text="Vence: 2026-05-25" />

        <TextView
            android:id="@+id/tvPrecioNormal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#9E9E9E"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvNombreProducto"
            app:layout_constraintTop_toBottomOf="@+id/tvExpiracion"
            tools:text="S/ 12.00" />

        <View
            android:id="@+id/viewTachado"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:background="#F44336"
            app:layout_constraintBottom_toBottomOf="@+id/tvPrecioNormal"
            app:layout_constraintEnd_toEndOf="@+id/tvPrecioNormal"
            app:layout_constraintStart_toStartOf="@+id/tvPrecioNormal"
            app:layout_constraintTop_toTopOf="@+id/tvPrecioNormal" />

        <TextView
            android:id="@+id/tvPrecioOferta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#4CAF50"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/tvPrecioNormal"
            app:layout_constraintStart_toEndOf="@+id/tvPrecioNormal"
            app:layout_constraintTop_toTopOf="@+id/tvPrecioNormal"
            tools:text="S/ 6.00" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>