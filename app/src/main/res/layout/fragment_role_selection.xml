<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/donapp_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Botón Volver -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@color/donapp_surface"
            android:contentDescription="Volver atrás"
            android:padding="10dp"
            android:src="@android:drawable/ic_media_previous"
            app:cornerRadius="12dp"
            tools:ignore="TouchTargetSizeCheck" />

        <Space android:layout_height="32dp" android:layout_width="match_parent"/>

        <!-- Títulos Principales -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crear cuenta"
            android:textColor="@color/donapp_text_primary"
            android:textSize="32sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Cómo vas a usar la app?"
            android:textColor="@color/donapp_text_secondary"
            android:textSize="16sp"
            android:layout_marginTop="8dp"/>

        <Space android:layout_height="32dp" android:layout_width="match_parent"/>

        <!-- CARD 1: USUARIO (Estado Seleccionado) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1A1A00"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/donapp_primary"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_menu_user"
                    app:tint="@color/donapp_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Usuario"
                    android:textColor="@color/donapp_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Busca ofertas cercanas y ahorra en productos próximos a vencer"
                    android:textColor="@color/donapp_text_secondary"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipUsuarioSelected"
                    style="@style/Widget.MaterialComponents.Chip.Entry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ Seleccionado"
                    android:textSize="11sp"
                    app:chipBackgroundColor="@color/donapp_primary"
                    android:layout_marginTop="12dp"
                    android:visibility="visible"
                    />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARD 2: COMERCIANTE (Estado No Seleccionado) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardComerciante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#001209"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:layout_marginBottom="32dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_menu_seller"
                    app:tint="#00E676"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Comerciante"
                    android:textColor="@color/donapp_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:paddingBottom="6dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Conecta tus productos con quienes más los necesitan"
                    android:textColor="@color/donapp_text_secondary"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="10dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipComercianteSelected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ Seleccionado"
                    android:textColor="@color/donapp_bg"
                    android:textSize="11sp"
                    app:chipBackgroundColor="@color/donapp_primary"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Botón Continuar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinuar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Continuar"
            android:textColor="@color/donapp_bg"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@color/donapp_primary"
            app:cornerRadius="16dp"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>