<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_back"
            app:tint="?android:attr/textColorPrimary" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="16dp"
            android:background="?android:attr/listDivider" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivStoreLogo"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="?attr/colorPrimary"
                    android:padding="12dp"
                    android:src="@drawable/logo"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStoreName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bodega La Esquina"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@android:drawable/btn_star_big_on"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/tvRatingValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="5.0"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="16dp"
                            android:src="@android:drawable/ic_menu_mylocation"
                            app:tint="?attr/colorSecondary" />

                        <TextView
                            android:id="@+id/tvDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="0.3 km"
                            android:textColor="?attr/colorSecondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/ic_launcher_background"
                    android:backgroundTint="?attr/colorSurface"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:text="Horario"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        app:drawableStartCompat="@android:drawable/ic_menu_recent_history"
                        app:drawableTint="?android:attr/textColorSecondary" />
                    <TextView
                        android:id="@+id/tvSchedule"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Abierto Ahora"
                        android:textColor="@color/donapp_success"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/ic_launcher_background"
                    android:backgroundTint="?attr/colorSurface"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:text="Ofertas"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        app:drawableStartCompat="@android:drawable/ic_menu_agenda"
                        app:drawableTint="?attr/colorPrimary" />
                    <TextView
                        android:id="@+id/tvActiveOffersCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="3 activas"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Disponibles hoy"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHowToGet"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:minHeight="56dp"
                    android:paddingVertical="12dp"
                    android:text="LLEGAR"
                    android:textColor="?android:attr/windowBackground"
                    android:textStyle="bold"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="12dp"
                    app:icon="@android:drawable/ic_menu_send"
                    app:iconTint="?android:attr/windowBackground" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingVertical="12dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Llamar"
                    android:textColor="?android:attr/windowBackground"
                    android:textStyle="bold"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="12dp"
                    app:icon="@android:drawable/stat_sys_phone_call"
                    app:iconTint="?android:attr/windowBackground" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="?attr/colorSurface"
                android:drawablePadding="12dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:text="Cargando dirección..."
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"
                app:drawableStartCompat="@android:drawable/ic_menu_mylocation"
                app:drawableTint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/tvOffersLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Ofertas Disponibles"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAvailableOffers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="2"
                tools:listitem="@android:layout/simple_list_item_1" />

            <TextView
                android:id="@+id/tvReviewsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Reseñas ()"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/ic_launcher_background"
                android:backgroundTint="?attr/colorSurface"
                android:orientation="horizontal"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">
                    <RatingBar
                        android:id="@+id/rbAverage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="?android:attr/ratingBarStyleIndicator"
                        android:numStars="5"
                        android:rating="5"
                        android:progressTint="?attr/colorPrimary"
                        android:scaleX="0.6"
                        android:scaleY="0.6" />
                    <TextView
                        android:id="@+id/tvTotalReviewsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="reseñas"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="2dp">
                        <TextView android:layout_width="12dp" android:layout_height="wrap_content" android:text="5" android:textColor="?android:attr/textColorPrimary" android:textSize="12sp"/>
                        <ImageView android:layout_width="10dp" android:layout_height="10dp" android:src="@android:drawable/btn_star_big_on" app:tint="?android:attr/textColorSecondary" android:layout_marginStart="4dp"/>
                        <ProgressBar android:id="@+id/pb5Stars" android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:layout_marginHorizontal="8dp" style="?android:attr/progressBarStyleHorizontal" android:progress="85" android:progressTint="?attr/colorPrimary"/>
                        <TextView android:id="@+id/tv5StarsPct" android:layout_width="30dp" android:layout_height="wrap_content" android:text="85%" android:textColor="?android:attr/textColorSecondary" android:textSize="11sp" android:gravity="end"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="2dp">
                        <TextView android:layout_width="12dp" android:layout_height="wrap_content" android:text="4" android:textColor="?android:attr/textColorPrimary" android:textSize="12sp"/>
                        <ImageView android:layout_width="10dp" android:layout_height="10dp" android:src="@android:drawable/btn_star_big_on" app:tint="?android:attr/textColorSecondary" android:layout_marginStart="4dp"/>
                        <ProgressBar android:id="@+id/pb4Stars" android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:layout_marginHorizontal="8dp" style="?android:attr/progressBarStyleHorizontal" android:progress="10" android:progressTint="?attr/colorPrimary"/>
                        <TextView android:id="@+id/tv4StarsPct" android:layout_width="30dp" android:layout_height="wrap_content" android:text="10%" android:textColor="?android:attr/textColorSecondary" android:textSize="11sp" android:gravity="end"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="2dp">
                        <TextView android:layout_width="12dp" android:layout_height="wrap_content" android:text="3" android:textColor="?android:attr/textColorPrimary" android:textSize="12sp"/>
                        <ImageView android:layout_width="10dp" android:layout_height="10dp" android:src="@android:drawable/btn_star_big_on" app:tint="?android:attr/textColorSecondary" android:layout_marginStart="4dp"/>
                        <ProgressBar android:id="@+id/pb3Stars" android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:layout_marginHorizontal="8dp" style="?android:attr/progressBarStyleHorizontal" android:progress="5" android:progressTint="?attr/colorPrimary"/>
                        <TextView android:id="@+id/tv3StarsPct" android:layout_width="30dp" android:layout_height="wrap_content" android:text="5%" android:textColor="?android:attr/textColorSecondary" android:textSize="11sp" android:gravity="end"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="2dp">
                        <TextView android:layout_width="12dp" android:layout_height="wrap_content" android:text="2" android:textColor="?android:attr/textColorPrimary" android:textSize="12sp"/>
                        <ImageView android:layout_width="10dp" android:layout_height="10dp" android:src="@android:drawable/btn_star_big_on" app:tint="?android:attr/textColorSecondary" android:layout_marginStart="4dp"/>
                        <ProgressBar android:id="@+id/pb2Stars" android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:layout_marginHorizontal="8dp" style="?android:attr/progressBarStyleHorizontal" android:progress="5" android:progressTint="?attr/colorPrimary"/>
                        <TextView android:id="@+id/tv2StarsPct" android:layout_width="30dp" android:layout_height="wrap_content" android:text="5%" android:textColor="?android:attr/textColorSecondary" android:textSize="11sp" android:gravity="end"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:layout_width="12dp" android:layout_height="wrap_content" android:text="1" android:textColor="?android:attr/textColorPrimary" android:textSize="12sp"/>
                        <ImageView android:layout_width="10dp" android:layout_height="10dp" android:src="@android:drawable/btn_star_big_on" app:tint="?android:attr/textColorSecondary" android:layout_marginStart="4dp"/>
                        <ProgressBar android:id="@+id/pb1Star" android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:layout_marginHorizontal="8dp" style="?android:attr/progressBarStyleHorizontal" android:progress="5" android:progressTint="?attr/colorPrimary"/>
                        <TextView android:id="@+id/tv1StarPct" android:layout_width="30dp" android:layout_height="wrap_content" android:text="5%" android:textColor="?android:attr/textColorSecondary" android:textSize="11sp" android:gravity="end"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvReviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="2"
                tools:listitem="@android:layout/simple_list_item_1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingVertical="12dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="32dp"
                android:text="Añadir reseña"
                android:textColor="?android:attr/windowBackground"
                android:textStyle="bold"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>