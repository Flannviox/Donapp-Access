<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="152dp"
    android:layout_margin="6dp"
    android:background="@drawable/bg_surface"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/textCategoriaInicial"
        android:layout_width="76dp"
        android:layout_height="62dp"
        android:gravity="center"
        android:textSize="38sp"
        tools:text="🥐" />

    <TextView
        android:id="@+id/textCategoriaNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:gravity="start"
        android:maxLines="2"
        android:textColor="?android:attr/textColorPrimary"        android:textSize="18sp"
        tools:text="Panaderia" />

    <TextView
        android:id="@+id/textCategoriaConteo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:textColor="?android:attr/textColorSecondary"        android:textSize="16sp"
        tools:text="12 ofertas" />
</LinearLayout>
