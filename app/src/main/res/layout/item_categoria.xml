<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="116dp"
    android:layout_margin="5dp"
    android:background="@drawable/bg_surface"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/textCategoriaInicial"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_surface_yellow_stroke"
        android:gravity="center"
        android:textColor="@color/donapp_yellow"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="P" />

    <TextView
        android:id="@+id/textCategoriaNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/donapp_text_primary"
        android:textSize="13sp"
        tools:text="Panaderia" />

    <TextView
        android:id="@+id/textCategoriaConteo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="@color/donapp_text_muted"
        android:textSize="11sp"
        tools:text="12 ofertas" />
</LinearLayout>
