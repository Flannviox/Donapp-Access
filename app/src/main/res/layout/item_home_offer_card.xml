<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="154dp"
    android:background="@drawable/bg_surface"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:layout_width="116dp"
        android:layout_height="116dp"
        android:background="@drawable/bg_surface_stroke"
        android:gravity="center"
        android:text="🍞"
        android:textSize="54sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pan blanco Bimbo"
            android:textColor="@color/donapp_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bodega el chamo"
            android:textColor="@color/donapp_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="S/ 5.00"
                android:textColor="@color/donapp_text_muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="64dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_discount"
                android:gravity="center"
                android:text="-50 %"
                android:textColor="@color/donapp_error"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="S/ 2.00"
            android:textColor="@color/donapp_yellow"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="◎ 0.3 km"
                android:textColor="@color/donapp_blue"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expira en\n2h 30 min"
                android:textColor="@color/donapp_orange"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
