<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTituloDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gestión del Lote"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvEstadoActual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_discount_tag_green"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTituloDetalle"
            tools:text="Estado: en_oferta" />

        <TextView
            android:id="@+id/tvLabelCantidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Cantidad disponible:"
            android:textColor="#9E9E9E"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEstadoActual" />

        <EditText
            android:id="@+id/etCantidad"
            android:hint="0"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="#2A2A2A"
            android:inputType="number"
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/tvLabelCantidad" />

        <TextView
            android:id="@+id/tvLabelPrecioNormal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Precio Normal (S/):"
            android:textColor="#9E9E9E"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etCantidad" />

        <EditText
            android:id="@+id/etPrecioNormal"
            android:layout_width="match_parent"
            android:hint="0"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="#2A2A2A"
            android:inputType="numberDecimal"
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/tvLabelPrecioNormal" />

        <TextView
            android:id="@+id/tvLabelPrecioOferta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Precio de Oferta (S/):"
            android:textColor="#9E9E9E"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etPrecioNormal" />

        <EditText
            android:id="@+id/etPrecioOferta"
            android:hint="0"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="#2A2A2A"
            android:inputType="numberDecimal"
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/tvLabelPrecioOferta" />

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:paddingVertical="12dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#F5C518"
            android:text="Guardar Cambios"
            android:textColor="#1A1A1A"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/etPrecioOferta" />

        <LinearLayout
            android:id="@+id/llRegistrarVenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:weightSum="1"
            app:layout_constraintTop_toBottomOf="@+id/btnGuardar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.4"
                android:hint="Vendidos"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxBackgroundColor="#2A2A2A"
                app:hintTextColor="#9E9E9E">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCantidadVenta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrarVenta"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.6"
                android:layout_marginStart="8dp"
                android:text="Registrar Venta"
                app:backgroundTint="#4CAF50" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEliminar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Eliminar Lote Definitivamente"
            android:textColor="#FFFFFF"
            app:backgroundTint="#F44336"
            app:layout_constraintTop_toBottomOf="@+id/llRegistrarVenta"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>