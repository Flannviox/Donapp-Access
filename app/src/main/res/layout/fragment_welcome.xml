<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/donapp_bg"
    android:orientation="vertical"
    android:gravity="center">

    <ImageView
        android:layout_width="600dp"
        android:layout_height="200dp"
        android:src="@drawable/logo"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_height="wrap_content"
        android:width="210dp"
        android:gravity="center"
        android:text="Conectamos bodegas con ofertas accesibles cerca de ti"
        android:textColor="@color/donapp_text_secondary"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="40dp">

        <!-- ITEM 1 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_menu_seller"
                app:tint="@color/donapp_text_primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bodegas"
                android:textColor="@color/donapp_text_primary"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- ITEM 2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_accessibility"
                app:tint="@color/donapp_text_primary"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accesible para todos"
                android:textColor="@color/donapp_text_primary"
                android:layout_marginTop="8dp"
                android:gravity="center"/>
        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCrearAccount"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="30dp"
        android:text="Crear Cuenta"
        android:textColor="@color/donapp_bg"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/donapp_primary"
        app:cornerRadius="12dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIniciarSesion"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:paddingVertical="12dp"
        android:text="Inciar sesión"
        android:layout_marginTop="30dp"
        app:backgroundTint="@color/donapp_secondary"/>


</LinearLayout>